{
  "manifest_version": 3,
  "name": "MediumStreak",
  "version": "1.2.1",
  "description": "Turn your reading into a streak. Track articles across your favorite sites and watch your heatmap fill up.",
  "permissions": ["storage", "alarms", "notifications", "contextMenus", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "https://medium.com/*",
    "https://*.medium.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://medium.com/*",
        "https://*.medium.com/*"
      ],
      "js": ["content/reader.js", "content/celebrate.js"],
      "css": ["content/celebrate.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MediumStreak — your reading streak",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
